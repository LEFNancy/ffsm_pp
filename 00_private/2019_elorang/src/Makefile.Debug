QMAKE_TARGET  = ffsm_debug
DESTDIR       = ../
TARGET        = ../ffsm_debug


first: all
####### Build rules

../ffsm_debug: ui_MainWindow.h $(OBJECTS)  
	@test -d ../ || mkdir -p ../
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJCOMP) $(LIBS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Debug src.pro -spec linux-g++

qmake_all: FORCE


all: Makefile.Debug ../ffsm_debug

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents resources.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents Adolc_debugtest.h CommonLib.h BaseClass.h Gis.h Init.h InputNode.h Ipopt_nlp_problem_debugtest.h MainProgram.h MainWindow.h ModelData.h ModelRegion.h Opt.h Output.h Pixel.h Sandbox.h Scheduler.h ThreadManager.h MapBox.h Layers.h unzip.h unzip_p.h zip.h zip_p.h zipentry_p.h anyoption.h ScenarioSelectionWidget.h ModelCore.h ModelCoreSpatial.h Carbon.h $(DISTDIR)/
	$(COPY_FILE) --parents Adolc_debugtest.cpp CommonLib.cpp BaseClass.cpp Gis.cpp Init.cpp Ipopt_nlp_problem_debugtest.cpp InputNode.cpp main.cpp MainProgram.cpp ModelData.cpp ModelRegion.cpp Opt.cpp Output.cpp Pixel.cpp Scheduler.cpp Sandbox.cpp ThreadManager.cpp MainWindow.cpp MapBox.cpp Layers.cpp unzip.cpp zip.cpp anyoption.cpp ScenarioSelectionWidget.cpp ModelCore.cpp ModelCoreSpatial.cpp Carbon.cpp $(DISTDIR)/
	$(COPY_FILE) --parents MainWindow.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) Makefile.Debug


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all: ../build/debug/qrc_resources.cpp
compiler_rcc_clean:
	-$(DEL_FILE) ../build/debug/qrc_resources.cpp
../build/debug/qrc_resources.cpp: resources.qrc \
		/usr/lib/qt5/bin/rcc \
		imgs/icon.png \
		imgs/save.png \
		imgs/stop.png \
		imgs/open.png \
		imgs/help.png \
		imgs/play.png \
		imgs/options.png \
		imgs/view-refresh.png \
		imgs/clear.png \
		imgs/saveas.png \
		imgs/exit.png \
		imgs/pause.png \
		imgs/showHideLogArea.png \
		imgs/info.png
	/usr/lib/qt5/bin/rcc -name resources resources.qrc -o ../build/debug/qrc_resources.cpp

compiler_moc_predefs_make_all: ../build/debug/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) ../build/debug/moc_predefs.h
../build/debug/moc_predefs.h: /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp
	g++ -pipe -std=c++0x -g -D_REENTRANT -dM -E -o ../build/debug/moc_predefs.h /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp

