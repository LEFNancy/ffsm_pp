	-$(DEL_FILE) ../build/debug/moc_MainWindow.cpp ../build/debug/moc_Sandbox.cpp ../build/debug/moc_ThreadManager.cpp ../build/debug/moc_MapBox.cpp ../build/debug/moc_ScenarioSelectionWidget.cpp
