# ignoring all model results, object files, the pythia executable, qmake/compilation temporary files and any backup files left by editors
*~
*.~lock.*
*data/output/results/*
*data/output/maps/asciiGrids/*
*data/output/maps/colr/*
*data/output/maps/floatListLayers
*data/output/maps/integerListLayers
*data/output/maps/scenarioName
*data/output/maps/bitmaps/*
*data/output/maps/cats/*
*data/output/tables/*
*data/output/charts/*.pdf
*data/output/charts/png/*.png
*data/output/optimisationLog.txt
*data/output/debugOut.csv
logs/*
data/tempInput-*
!**/00_doNotRemove.txt

